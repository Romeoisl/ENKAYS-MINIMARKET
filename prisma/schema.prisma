generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
  COMING_SOON
  UNAVAILABLE
}

enum SalesMethod {
  WHATSAPP
  PHONE
  DISABLED
}

enum PriceVisibility {
  SHOW_PRICE
  CONTACT_FOR_PRICE
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CmsContentType {
  HERO
  HERO_SLIDE
  BANNER
  HOMEPAGE_SECTION
  TESTIMONIAL
  FAQ
  ABOUT
  FOOTER
  CONTACT
  SEO
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  SEARCH
  SEARCH_RESULT_CLICK
  WISHLIST_ADD
  WISHLIST_REMOVE
  WHATSAPP_CLICK
  CONTACT_CLICK
  PROMOTION_CLICK
  BANNER_CLICK
  REVIEW_SUBMITTED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(EDITOR)
  active Boolean @default(true)
  avatar String?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  @@index([role, active])
}
model AuditLog {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  action String
  resource String
  resourceId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([resource, resourceId, createdAt])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String? @unique
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  reviews Review[]
  wishlist WishlistItem[]
  recentlyViewed RecentlyViewed[]
  couponUsages CouponUsage[]
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  image String?
  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  active Boolean @default(true)
  position Int @default(0)
  products Product[]
  promotions PromotionCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId, active, position])
}
model Brand {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  logo String?
  active Boolean @default(true)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, name])
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  shortDescription String?
  price Int
  compareAtPrice Int?
  currency String @default("NGN")
  sku String @unique
  stock Int @default(0)
  status ProductStatus @default(DRAFT)
  featured Boolean @default(false)
  published Boolean @default(false)
  salesMethod SalesMethod @default(WHATSAPP)
  priceVisibility PriceVisibility @default(SHOW_PRICE)
  brandId String?
  categoryId String?
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images ProductImage[]
  variants ProductVariant[]
  reviews Review[]
  orderItems OrderItem[]
  wishlistedBy WishlistItem[]
  recentlyViewed RecentlyViewed[]
  promotionItems PromotionProduct[]
  flashSaleItems FlashSaleItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId])
  @@index([brandId])
  @@index([status, published])
  @@index([featured, published, createdAt])
  @@index([price])
  @@index([stock])
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicId String @unique
  url String
  secureUrl String
  width Int?
  height Int?
  format String?
  bytes Int?
  alt String?
  position Int @default(0)
  createdAt DateTime @default(now())
  @@index([productId, position])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  value String
  sku String? @unique
  price Int?
  stock Int @default(0)
  active Boolean @default(true)
  options Json?
  imageId String?
  createdAt DateTime @default(now())
  @@index([productId, active])
}
model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  customerEmail String?
  customerPhone String
  status OrderStatus @default(PENDING)
  subtotal Int
  discount Int @default(0)
  total Int
  currency String @default("NGN")
  paymentMethod String?
  paymentStatus PaymentStatus @default(PENDING)
  notes String?
  items OrderItem[]
  couponUsages CouponUsage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  skuSnapshot String
  quantity Int
  unitPrice Int
  total Int
  variantSnapshot Json?
  @@index([orderId])
  @@index([productId])
}
model Review {
  id String @id @default(cuid())
  productId String
  customerId String?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating Int
  title String?
  content String
  images Json?
  verifiedPurchase Boolean @default(false)
  helpfulVotes Int @default(0)
  status ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productId, status, createdAt])
  @@index([customerId])
}
model WishlistItem {
  id String @id @default(cuid())
  customerId String?
  guestSessionId String?
  productId String
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([productId])
}
model RecentlyViewed {
  id String @id @default(cuid())
  customerId String?
  guestSessionId String?
  productId String
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  @@index([customerId, viewedAt])
  @@index([guestSessionId, viewedAt])
  @@index([productId, viewedAt])
}
model Promotion {
  id String @id @default(cuid())
  name String
  description String?
  type PromotionType
  value Int
  minOrder Int?
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(true)
  products PromotionProduct[]
  categories PromotionCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, startsAt, endsAt])
}
model PromotionProduct {
  promotionId String
  productId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([promotionId, productId])
  @@index([productId])
}
model PromotionCategory {
  promotionId String
  categoryId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([promotionId, categoryId])
  @@index([categoryId])
}
model FlashSale {
  id String @id @default(cuid())
  name String
  campaign String?
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(true)
  items FlashSaleItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, startsAt, endsAt])
}
model FlashSaleItem {
  id String @id @default(cuid())
  flashSaleId String
  productId String
  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice Int
  originalPrice Int
  stockAllocation Int
  quantityLimit Int?
  createdAt DateTime @default(now())
  @@unique([flashSaleId, productId])
  @@index([productId])
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  type CouponType
  value Int
  minimumOrder Int?
  expiresAt DateTime?
  usageLimit Int?
  usageCount Int @default(0)
  perCustomerLimit Int?
  active Boolean @default(true)
  usages CouponUsage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, expiresAt])
}
model CouponUsage {
  id String @id @default(cuid())
  couponId String
  customerId String?
  orderId String?
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt DateTime @default(now())
  @@index([customerId, couponId])
  @@index([orderId])
}
model CmsContent {
  id String @id @default(cuid())
  type CmsContentType
  key String @unique
  title String?
  content Json
  position Int @default(0)
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, active, position])
}
model SiteSettings {
  id Int @id @default(1)
  siteName String @default("Enkays Foods & More")
  logo String?
  favicon String?
  currency String @default("NGN")
  whatsappNumber String?
  phoneNumber String?
  supportEmail String?
  defaultWhatsAppMessage String?
  includePriceInWhatsApp Boolean @default(true)
  includeSkuInWhatsApp Boolean @default(true)
  includeProductUrlInWhatsApp Boolean @default(true)
  seoTitle String?
  seoDescription String?
  socialLinks Json?
  branding Json?
  orderPrefix String @default("ENK")
  updatedAt DateTime @updatedAt
}
model AnalyticsEvent {
  id String @id @default(cuid())
  type AnalyticsEventType
  productId String?
  customerId String?
  sessionId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}
